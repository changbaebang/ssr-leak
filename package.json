{
  "name": "ssr-leak",
  "version": "0.1.0",
  "description": "Static checker that catches module-scope state (axios.defaults, interceptors, module-level variables, globalThis) leaking between SSR requests in Next.js",
  "license": "MIT",
  "author": "Changbae Bang",
  "repository": { "type": "git", "url": "git+https://github.com/changbaebang/ssr-leak.git" },
  "homepage": "https://github.com/changbaebang/ssr-leak#readme",
  "bugs": { "url": "https://github.com/changbaebang/ssr-leak/issues" },
  "keywords": [
    "nextjs",
    "ssr",
    "axios",
    "security",
    "static-analysis",
    "lint",
    "module-scope",
    "request-isolation",
    "data-leak",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "engines": { "node": ">=20" },
  "bin": { "ssr-leak": "dist/cli.js" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "README.ko.md", "LICENSE", "CHANGELOG.md"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
